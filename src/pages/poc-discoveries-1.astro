---
import BaseLayout from '../layouts/BaseLayout.astro'

// Sample discovery data - this would normally come from a content collection
const discoveries = [
    {
        id: 1,
        device: 'MacBook Air Early 2015',
        title: 'Screen Replacement Impossibility',
        finding:
            "While trying to teardown the MacBook Air Early 2015 display, I discovered it was made impossible to replace just the screen. You're forced to replace the entire head assembly—attempting to take the screen out will cause inevitable damage. In my case, a good screen got cracked (I just wanted the LED backlighting).",
        date: new Date('2024-12-19'),
        severity: 'critical', // critical, warning, insight
        icon: '💔',
    },
]
---

<BaseLayout title="Discoveries POC 1 - Card Layout">
    <div class="poc-container">
        <header class="poc-header">
            <h1>Discoveries</h1>
            <p class="poc-subtitle">
                POC 1: Stacked Card Layout with Severity Indicators
            </p>
        </header>

        <section class="discoveries-section">
            {
                discoveries.map((discovery) => (
                    <article
                        class={`discovery-card severity-${discovery.severity}`}
                    >
                        <div class="card-accent" />
                        <div class="card-header">
                            <span class="discovery-icon">{discovery.icon}</span>
                            <div class="header-text">
                                <span class="device-badge">
                                    {discovery.device}
                                </span>
                                <time datetime={discovery.date.toISOString()}>
                                    {discovery.date.toLocaleDateString(
                                        'en-US',
                                        {
                                            year: 'numeric',
                                            month: 'long',
                                            day: 'numeric',
                                        }
                                    )}
                                </time>
                            </div>
                            <span
                                class={`severity-badge ${discovery.severity}`}
                            >
                                {discovery.severity}
                            </span>
                        </div>
                        <h2 class="discovery-title">{discovery.title}</h2>
                        <p class="discovery-finding">{discovery.finding}</p>
                    </article>
                ))
            }
        </section>

        <div class="poc-nav">
            <a href="/poc-discoveries-2">→ View POC 2: Timeline Layout</a>
            <a href="/poc-discoveries-3">→ View POC 3: Micro-Card Grid</a>
        </div>
    </div>
</BaseLayout>

<style>
    .poc-container {
        max-width: 800px;
        margin: 0 auto;
        padding: 6rem 2rem;
    }

    .poc-header {
        text-align: center;
        margin-bottom: 4rem;
    }

    .poc-header h1 {
        font-size: var(--md-sys-typescale-display-medium-size);
        font-weight: var(--md-sys-typescale-display-medium-weight);
        color: var(--md-sys-color-on-background);
        margin-bottom: 0.5rem;
    }

    .poc-subtitle {
        color: var(--md-sys-color-on-surface-variant);
        font-size: var(--md-sys-typescale-body-large-size);
    }

    .discoveries-section {
        display: flex;
        flex-direction: column;
        gap: 2rem;
    }

    .discovery-card {
        position: relative;
        background: var(--md-sys-color-surface-container);
        border-radius: var(--md-sys-shape-corner-extra-large);
        padding: 2rem;
        overflow: hidden;
        box-shadow: var(--md-sys-elevation-level2);
        transition: all var(--md-sys-motion-duration-medium)
            var(--md-sys-motion-easing-spring-soft);
    }

    .discovery-card:hover {
        transform: translateX(8px);
        box-shadow: var(--md-sys-elevation-level4);
    }

    .card-accent {
        position: absolute;
        left: 0;
        top: 0;
        bottom: 0;
        width: 6px;
        border-radius: 0 6px 6px 0;
    }

    .severity-critical .card-accent {
        background: linear-gradient(180deg, #ff5252, #d32f2f);
    }

    .severity-warning .card-accent {
        background: linear-gradient(180deg, #ffab40, #ff9100);
    }

    .severity-insight .card-accent {
        background: linear-gradient(
            180deg,
            var(--md-sys-color-primary),
            var(--md-sys-color-primary-container)
        );
    }

    .card-header {
        display: flex;
        align-items: center;
        gap: 1rem;
        margin-bottom: 1rem;
        flex-wrap: wrap;
    }

    .discovery-icon {
        font-size: 2rem;
        line-height: 1;
    }

    .header-text {
        flex: 1;
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
    }

    .device-badge {
        font-size: var(--md-sys-typescale-label-large-size);
        font-weight: var(--md-sys-typescale-label-large-weight);
        color: var(--md-sys-color-primary);
    }

    .header-text time {
        font-size: var(--md-sys-typescale-label-medium-size);
        color: var(--md-sys-color-on-surface-variant);
    }

    .severity-badge {
        padding: 0.35rem 0.85rem;
        border-radius: var(--md-sys-shape-corner-full);
        font-size: var(--md-sys-typescale-label-medium-size);
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .severity-badge.critical {
        background: rgba(255, 82, 82, 0.2);
        color: #ff5252;
    }

    .severity-badge.warning {
        background: rgba(255, 171, 64, 0.2);
        color: #ffab40;
    }

    .severity-badge.insight {
        background: var(--md-sys-color-primary-container);
        color: var(--md-sys-color-on-primary-container);
    }

    .discovery-title {
        font-size: var(--md-sys-typescale-headline-medium-size);
        font-weight: 500;
        color: var(--md-sys-color-on-surface);
        margin-bottom: 1rem;
    }

    .discovery-finding {
        color: var(--md-sys-color-on-surface-variant);
        font-size: var(--md-sys-typescale-body-large-size);
        line-height: 1.7;
    }

    .poc-nav {
        margin-top: 4rem;
        display: flex;
        flex-direction: column;
        gap: 1rem;
        text-align: center;
    }

    .poc-nav a {
        color: var(--md-sys-color-primary);
        text-decoration: none;
        font-size: var(--md-sys-typescale-body-large-size);
        transition: color var(--md-sys-motion-duration-short)
            var(--md-sys-motion-easing-standard);
    }

    .poc-nav a:hover {
        color: var(--md-sys-color-on-primary-container);
    }

    @media (max-width: 600px) {
        .poc-container {
            padding: 4rem 1rem;
        }

        .discovery-card {
            padding: 1.5rem;
        }

        .card-header {
            flex-direction: column;
            align-items: flex-start;
        }

        .discovery-icon {
            font-size: 1.5rem;
        }
    }
</style>
