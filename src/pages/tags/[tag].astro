---
import BaseLayout from '../../layouts/BaseLayout.astro'
import { getCollection } from 'astro:content'
import OptimizedImage from '../../components/OptimizedImage.astro'

export async function getStaticPaths() {
  const teardowns = await getCollection('teardowns')

  // Collect all unique tags
  const allTags = new Set<string>()
  teardowns.forEach((teardown) => {
    teardown.data.tags?.forEach((tag) => allTags.add(tag))
  })

  return Array.from(allTags).map((tag) => ({
    params: { tag },
    props: { tag },
  }))
}

const { tag } = Astro.props

// Get all teardowns with this tag
const allTeardowns = await getCollection('teardowns')
const taggedTeardowns = allTeardowns
  .filter((teardown) => teardown.data.tags?.includes(tag))
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
---

<BaseLayout title={`#${tag}`} description={`All teardowns tagged with ${tag}`}>
  <div class="tag-page">
    <header class="tag-header">
      <div class="tag-badge">#{tag}</div>
      <h1>{taggedTeardowns.length} teardown{taggedTeardowns.length !== 1 ? 's' : ''}</h1>
      <a href="/field-notes" class="back-link">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="back-icon">
          <path d="M19 12H5M12 19l-7-7 7-7" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        Back to all teardowns
      </a>
    </header>

    <div class="teardowns-grid">
      {taggedTeardowns.map((teardown) => (
        <article class="teardown-card">
          <a href={`/teardowns/${teardown.id}`} class="card-link">
            <div class="card-image">
              {teardown.data.heroImage ? (
                <OptimizedImage
                  src={teardown.data.heroImage}
                  alt={teardown.data.title}
                  loading="lazy"
                  aspect="video"
                  sizes="(max-width: 768px) 90vw, 400px"
                />
              ) : (
                <div class="placeholder-image">
                  <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <rect x="3" y="3" width="18" height="18" rx="2" ry="2" />
                    <circle cx="8.5" cy="8.5" r="1.5" />
                    <polyline points="21,15 16,10 5,21" />
                  </svg>
                </div>
              )}
            </div>
            <div class="card-content">
              <h3 class="card-title">{teardown.data.title}</h3>
              <p class="card-description">{teardown.data.description}</p>
              <div class="card-meta">
                <span class={`difficulty difficulty-${teardown.data.difficulty}`}>
                  {teardown.data.difficulty}
                </span>
                <time class="card-date">
                  {teardown.data.pubDate.toLocaleDateString('en-US', {
                    year: 'numeric',
                    month: 'short',
                    day: 'numeric',
                  })}
                </time>
              </div>
            </div>
          </a>
        </article>
      ))}
    </div>
  </div>
</BaseLayout>

<style>
  .tag-page {
    max-width: 1200px;
    margin: 0 auto;
    padding: 2rem 1.5rem;
  }

  .tag-header {
    text-align: center;
    margin-bottom: 3rem;
  }

  .tag-badge {
    display: inline-block;
    padding: 0.5rem 1.5rem;
    background: var(--md-sys-color-primary);
    color: var(--md-sys-color-on-primary);
    border-radius: 9999px;
    font-size: 1.5rem;
    font-weight: 500;
    margin-bottom: 1rem;
  }

  .tag-header h1 {
    font-size: var(--md-sys-typescale-headline-large-size, 2rem);
    color: var(--md-sys-color-on-surface);
    margin-bottom: 1.5rem;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--md-sys-color-primary);
    text-decoration: none;
    font-size: 0.9rem;
    transition: opacity 0.2s;
  }

  .back-link:hover {
    opacity: 0.8;
  }

  .back-icon {
    width: 1rem;
    height: 1rem;
  }

  .teardowns-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 2rem;
  }

  .teardown-card {
    background: var(--md-sys-color-surface-container);
    border-radius: var(--md-sys-shape-corner-large, 16px);
    overflow: hidden;
    box-shadow: var(--md-sys-elevation-level1);
    transition: all 0.2s ease;
  }

  .teardown-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--md-sys-elevation-level3);
  }

  .card-link {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .card-image {
    width: 100%;
    min-height: 140px;
    max-height: 220px;
    overflow: hidden;
    background: var(--md-sys-color-surface-container-low);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .card-image :global(picture.optimized-picture) {
    display: block;
    width: 100%;
  }

  .card-image :global(picture.optimized-picture .optimized-img) {
    width: 100%;
    height: auto;
    max-height: 220px;
    object-fit: contain;
    aspect-ratio: auto;
    border-radius: 0;
  }

  .placeholder-image {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--md-sys-color-on-surface-variant);
  }

  .card-content {
    padding: 1.25rem;
  }

  .card-title {
    font-size: 1.1rem;
    font-weight: 600;
    margin-bottom: 0.5rem;
    color: var(--md-sys-color-on-surface);
    line-height: 1.3;
  }

  .card-description {
    font-size: 0.9rem;
    color: var(--md-sys-color-on-surface-variant);
    margin-bottom: 1rem;
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .difficulty {
    padding: 0.2rem 0.6rem;
    border-radius: 9999px;
    font-size: 0.75rem;
    font-weight: 500;
    text-transform: capitalize;
  }

  .difficulty-easy {
    background-color: var(--badge-difficulty-easy-bg);
    color: var(--badge-difficulty-easy-text);
  }

  .difficulty-medium {
    background-color: var(--badge-difficulty-medium-bg);
    color: var(--badge-difficulty-medium-text);
  }

  .difficulty-hard {
    background-color: var(--badge-difficulty-hard-bg);
    color: var(--badge-difficulty-hard-text);
  }

  .card-date {
    color: var(--md-sys-color-on-surface-variant);
    font-size: 0.8rem;
  }

  @media (max-width: 640px) {
    .teardowns-grid {
      grid-template-columns: 1fr;
    }

    .card-image {
      min-height: 120px;
      max-height: 180px;
    }

    .card-image :global(picture.optimized-picture .optimized-img) {
      max-height: 180px;
    }
  }
</style>
