---
import BaseLayout from '../layouts/BaseLayout.astro'

// Sample discovery data
const discoveries = [
    {
        id: 1,
        device: 'MacBook Air Early 2015',
        component: 'Display Assembly',
        title: 'Screen Replacement Impossibility',
        tldr: "You're forced to replace the entire head assembly—screen extraction causes inevitable damage.",
        finding:
            "While trying to teardown the MacBook Air Early 2015 display, I discovered it was made impossible to replace just the screen. You're forced to replace the entire head assembly—attempting to take the screen out will cause inevitable damage. In my case, a good screen got cracked (I just wanted the LED backlighting).",
        date: new Date('2024-12-19'),
        type: 'caution', // caution, discovery, hack, tip
    },
]

const typeConfig = {
    caution: { icon: '🚫', label: 'Caution', color: '#ff5252' },
    discovery: { icon: '💡', label: 'Discovery', color: '#ffa726' },
    hack: { icon: '⚡', label: 'Hack', color: '#66bb6a' },
    tip: { icon: '💜', label: 'Pro Tip', color: '#d4bcff' },
}
---

<BaseLayout title="Discoveries POC 3 - Micro Cards">
    <div class="poc-container">
        <header class="poc-header">
            <h1>💀 The Graveyard</h1>
            <p class="poc-subtitle">POC 3: Expandable Micro-Cards with TL;DR</p>
            <p class="poc-description">Lessons learned the hard way</p>
        </header>

        <section class="micro-cards-section">
            {
                discoveries.map((discovery) => {
                    const config = typeConfig[discovery.type]
                    return (
                        <details
                            class="micro-card"
                            style={`--type-color: ${config.color}`}
                        >
                            <summary class="card-summary">
                                <div class="summary-left">
                                    <span class="type-icon">{config.icon}</span>
                                    <div class="summary-text">
                                        <span class="device-name">
                                            {discovery.device}
                                        </span>
                                        <span class="component-name">
                                            {discovery.component}
                                        </span>
                                    </div>
                                </div>
                                <div class="summary-center">
                                    <span class="tldr">{discovery.tldr}</span>
                                </div>
                                <div class="summary-right">
                                    <span class="type-badge">
                                        {config.label}
                                    </span>
                                    <span class="expand-indicator">▼</span>
                                </div>
                            </summary>
                            <div class="card-details">
                                <h3>{discovery.title}</h3>
                                <p class="full-finding">{discovery.finding}</p>
                                <footer class="card-footer">
                                    <time
                                        datetime={discovery.date.toISOString()}
                                    >
                                        Logged:{' '}
                                        {discovery.date.toLocaleDateString(
                                            'en-US',
                                            {
                                                year: 'numeric',
                                                month: 'long',
                                                day: 'numeric',
                                            }
                                        )}
                                    </time>
                                </footer>
                            </div>
                        </details>
                    )
                })
            }
        </section>

        <div class="poc-nav">
            <a href="/poc-discoveries-1">← View POC 1: Card Layout</a>
            <a href="/poc-discoveries-2">← View POC 2: Timeline Layout</a>
        </div>
    </div>
</BaseLayout>

<style>
    .poc-container {
        max-width: 1000px;
        margin: 0 auto;
        padding: 6rem 2rem;
    }

    .poc-header {
        text-align: center;
        margin-bottom: 4rem;
    }

    .poc-header h1 {
        font-size: var(--md-sys-typescale-display-medium-size);
        font-weight: var(--md-sys-typescale-display-medium-weight);
        color: var(--md-sys-color-on-background);
        margin-bottom: 0.5rem;
    }

    .poc-subtitle {
        color: var(--md-sys-color-on-surface-variant);
        font-size: var(--md-sys-typescale-body-large-size);
        margin-bottom: 0.25rem;
    }

    .poc-description {
        color: var(--md-sys-color-outline);
        font-size: var(--md-sys-typescale-body-medium-size);
        font-style: italic;
    }

    .micro-cards-section {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
    }

    .micro-card {
        background: var(--md-sys-color-surface-container);
        border-radius: var(--md-sys-shape-corner-medium);
        overflow: hidden;
        border: 1px solid var(--md-sys-color-outline-variant);
        transition: all var(--md-sys-motion-duration-short)
            var(--md-sys-motion-easing-standard);
    }

    .micro-card:hover {
        border-color: var(--type-color, var(--md-sys-color-primary));
        box-shadow: 0 0 0 1px var(--type-color, var(--md-sys-color-primary));
    }

    .micro-card[open] {
        border-color: var(--type-color, var(--md-sys-color-primary));
        background: var(--md-sys-color-surface-container-high);
    }

    .card-summary {
        display: grid;
        grid-template-columns: auto 1fr auto;
        gap: 1.5rem;
        align-items: center;
        padding: 1rem 1.5rem;
        cursor: pointer;
        list-style: none;
    }

    .card-summary::-webkit-details-marker {
        display: none;
    }

    .card-summary::marker {
        display: none;
    }

    .summary-left {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        min-width: 200px;
    }

    .type-icon {
        font-size: 1.5rem;
        width: 40px;
        height: 40px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: var(--md-sys-color-surface-container-highest);
        border-radius: var(--md-sys-shape-corner-small);
    }

    .summary-text {
        display: flex;
        flex-direction: column;
    }

    .device-name {
        font-size: var(--md-sys-typescale-title-medium-size);
        font-weight: 500;
        color: var(--md-sys-color-on-surface);
    }

    .component-name {
        font-size: var(--md-sys-typescale-label-medium-size);
        color: var(--md-sys-color-on-surface-variant);
    }

    .summary-center {
        flex: 1;
        min-width: 0;
    }

    .tldr {
        font-size: var(--md-sys-typescale-body-medium-size);
        color: var(--md-sys-color-on-surface-variant);
        line-height: 1.4;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .summary-right {
        display: flex;
        align-items: center;
        gap: 1rem;
    }

    .type-badge {
        padding: 0.35rem 0.85rem;
        border-radius: var(--md-sys-shape-corner-full);
        font-size: var(--md-sys-typescale-label-medium-size);
        font-weight: 600;
        background: color-mix(in oklch, var(--type-color) 20%, transparent);
        color: var(--type-color);
        white-space: nowrap;
    }

    .expand-indicator {
        color: var(--md-sys-color-on-surface-variant);
        font-size: 0.75rem;
        transition: transform var(--md-sys-motion-duration-short)
            var(--md-sys-motion-easing-spring);
    }

    .micro-card[open] .expand-indicator {
        transform: rotate(180deg);
    }

    .card-details {
        padding: 0 1.5rem 1.5rem 4.5rem;
        animation: slideDown 0.3s var(--md-sys-motion-easing-spring-soft);
    }

    @keyframes slideDown {
        from {
            opacity: 0;
            transform: translateY(-10px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .card-details h3 {
        font-size: var(--md-sys-typescale-title-large-size);
        font-weight: 500;
        color: var(--type-color, var(--md-sys-color-primary));
        margin-bottom: 0.75rem;
    }

    .full-finding {
        color: var(--md-sys-color-on-surface-variant);
        font-size: var(--md-sys-typescale-body-large-size);
        line-height: 1.7;
        margin-bottom: 1rem;
    }

    .card-footer {
        padding-top: 1rem;
        border-top: 1px solid var(--md-sys-color-outline-variant);
    }

    .card-footer time {
        font-size: var(--md-sys-typescale-label-medium-size);
        color: var(--md-sys-color-outline);
        font-family: var(--md-sys-typescale-code-font);
    }

    .poc-nav {
        margin-top: 4rem;
        display: flex;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 1rem;
    }

    .poc-nav a {
        color: var(--md-sys-color-primary);
        text-decoration: none;
        font-size: var(--md-sys-typescale-body-large-size);
        transition: color var(--md-sys-motion-duration-short)
            var(--md-sys-motion-easing-standard);
    }

    .poc-nav a:hover {
        color: var(--md-sys-color-on-primary-container);
    }

    @media (max-width: 768px) {
        .poc-container {
            padding: 4rem 1rem;
        }

        .card-summary {
            grid-template-columns: 1fr;
            gap: 0.75rem;
            padding: 1rem;
        }

        .summary-left {
            min-width: 0;
        }

        .summary-center {
            padding-left: 3rem;
        }

        .summary-right {
            padding-left: 3rem;
            justify-content: flex-start;
        }

        .card-details {
            padding-left: 1rem;
        }
    }
</style>
