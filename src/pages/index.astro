---
import BaseLayout from '../layouts/BaseLayout.astro'
import OptimizedImage from '../components/OptimizedImage.astro'
import { getCollection } from 'astro:content'

const latestNotes = (await getCollection('teardowns'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3)
---

<BaseLayout
  title="The Buying Desk"
  description="Send me a listing, shortlist, or buying problem. I'll check the price, red flags, and whether the thing actually fits what you need."
>
  <div class="desk-page">
    <div class="desk-sprites" aria-hidden="true">
      <svg class="desk-sprite desk-sprite-dossier" viewBox="0 0 120 120">
        <rect class="sprite-paper" x="24" y="18" width="72" height="88" rx="10"
        ></rect>
        <path d="M47 18v-5h26v5"></path>
        <rect x="42" y="12" width="36" height="13" rx="5"></rect>
        <g class="sprite-check sprite-check-one">
          <circle cx="43" cy="48" r="6"></circle>
          <path d="m40 48 2 2 4-5"></path>
          <path d="M57 48h24"></path>
        </g>
        <g class="sprite-check sprite-check-two">
          <circle cx="43" cy="68" r="6"></circle>
          <path d="m40 68 2 2 4-5"></path>
          <path d="M57 68h24"></path>
        </g>
        <g class="sprite-check sprite-check-three">
          <circle cx="43" cy="88" r="6"></circle>
          <path d="M57 88h18"></path>
        </g>
      </svg>

      <svg class="desk-sprite desk-sprite-lens" viewBox="0 0 120 120">
        <circle cx="52" cy="49" r="28"></circle>
        <path d="m72 70 27 27"></path>
        <path class="sprite-scan" d="M31 49h42"></path>
        <circle class="sprite-focus-dot" cx="52" cy="49" r="5"></circle>
      </svg>

      <svg class="desk-sprite desk-sprite-compare" viewBox="0 0 120 120">
        <path d="M22 96h78M28 96V26"></path>
        <rect
          class="sprite-bar sprite-bar-one"
          x="39"
          y="63"
          width="13"
          height="33"
          rx="4"></rect>
        <rect
          class="sprite-bar sprite-bar-two"
          x="59"
          y="47"
          width="13"
          height="49"
          rx="4"></rect>
        <rect
          class="sprite-bar sprite-bar-three"
          x="79"
          y="31"
          width="13"
          height="65"
          rx="4"></rect>
        <path class="sprite-trend" d="m38 54 24-15 18 5 19-20"></path>
      </svg>

      <svg class="desk-sprite desk-sprite-stamp" viewBox="0 0 120 120">
        <path d="M42 58V45c0-12 7-21 18-21s18 9 18 21v13"></path>
        <path d="M34 58h52l7 19H27z"></path>
        <rect x="22" y="78" width="76" height="21" rx="7"></rect>
        <path class="sprite-stamp-mark" d="m45 88 8 7 22-22"></path>
      </svg>
    </div>

    <section class="desk-hero" aria-labelledby="hero-title">
      <div>
        <p class="desk-eyebrow">Independent buying advice / copy 01</p>
        <h1 id="hero-title">Buy the right tech. Keep the receipt.</h1>
        <p class="desk-lede">
          Send me the listing, shortlist, or problem. I'll give you a straight
          answer and show you what I checked. No affiliate link nonsense. No
          chatbot shrug.
        </p>
        <div class="desk-actions">
          <a class="desk-button" href="/request">Start a request</a>
          <a class="desk-button secondary" href="/sample-report"
            >Read a sample report</a
          >
        </div>
      </div>
      <aside class="desk-receipt" data-label="Buying desk / intake">
        <strong>A paper trail for expensive decisions.</strong>
        <p>
          You get the verdict, fair price, red flags, and the exact questions
          worth asking. All based on how you'll actually use the thing.
        </p>
        <span class="desk-stamp">Independent by design</span>
      </aside>
    </section>

    <section
      class="desk-section"
      id="services"
      aria-labelledby="services-title"
    >
      <div class="desk-section-heading">
        <div>
          <p class="desk-kicker">Pick the decision, not a package</p>
          <h2 id="services-title">What do you need decided?</h2>
        </div>
        <p>
          This is a manual pilot. I'll confirm what I can check, how long it'll
          take, and the price by email before I start.
        </p>
      </div>
      <div class="desk-grid">
        <article class="desk-card">
          <p class="desk-code">Form A / single item</p>
          <h3>Check This</h3>
          <p>
            Send me one product or listing. I'll check fit, price, red flags,
            and what you should ask before paying.
          </p>
          <a class="desk-link" href="/request?service=check-this"
            >Request Check This →</a
          >
        </article>
        <article class="desk-card">
          <p class="desk-code">Form B / short list</p>
          <h3>Compare These</h3>
          <p>
            Send me 2 or 3 options. I'll compare them around your use instead of
            dumping a spec sheet on you.
          </p>
          <a class="desk-link" href="/request?service=compare-these"
            >Request Compare These →</a
          >
        </article>
        <article class="desk-card">
          <p class="desk-code">Form C / open search</p>
          <h3>Choose for Me</h3>
          <p>
            Give me the job, budget, region, and deal-breakers. I'll build a
            short list and tell you where each option cuts corners.
          </p>
          <a class="desk-link" href="/request?service=choose-for-me"
            >Request Choose for Me →</a
          >
        </article>
      </div>
    </section>

    <section class="desk-section" aria-labelledby="categories-title">
      <div class="desk-section-heading">
        <div>
          <p class="desk-kicker">Supported categories</p>
          <h2 id="categories-title">Tech that deserves a closer look.</h2>
        </div>
        <p>
          If it isnt listed, choose Other. I'll tell you if I cant check it
          properly.
        </p>
      </div>
      <ul class="desk-categories" aria-label="Supported product categories">
        <li>Laptops</li>
        <li>Tablets</li>
        <li>Keyboards</li>
        <li>3D printers</li>
        <li>Audio</li>
        <li>Phones</li>
        <li>PC parts</li>
        <li>Home servers</li>
        <li>Other tech</li>
      </ul>
    </section>

    <section class="desk-section" aria-labelledby="sample-title">
      <div class="desk-section-heading">
        <div>
          <p class="desk-kicker">A verdict you can act on</p>
          <h2 id="sample-title">The answer first. Receipts underneath.</h2>
        </div>
        <p>
          This is just the report format. I'll always tell you what I checked
          and what I couldnt verify.
        </p>
      </div>
      <div class="desk-two-column">
        <article class="desk-card desk-verdict">
          <span class="desk-verdict-badge">Proceed carefully</span>
          <h3>Good machine. Weak listing.</h3>
          <p>
            The laptop fits the work, but the seller hasn’t shown enough
            evidence to justify the asking price yet.
          </p>
          <div class="desk-price-line">
            <span>Fair-price range</span><strong>$340-$390</strong>
          </div>
        </article>
        <article class="desk-card">
          <p class="desk-code">Evidence register / sample</p>
          <ul class="desk-register">
            <li>
              <strong>Listing claim</strong>
              <span
                >16 GB memory and a replaced battery. Health isnt shown.</span
              >
            </li>
            <li>
              <strong>Measured research</strong>
              <span
                >The display and sustained performance suit the stated office
                work.</span
              >
            </li>
            <li>
              <strong>Warning sign</strong>
              <span
                >No serial photo or charging-cycle screenshot. Ask before
                paying.</span
              >
            </li>
            <li>
              <strong>Confidence</strong>
              <span>Medium. Enough to continue, not enough to buy unseen.</span>
            </li>
          </ul>
          <a class="desk-link" href="/sample-report">Open the full sample →</a>
        </article>
      </div>
    </section>

    <section class="desk-section" aria-labelledby="evidence-title">
      <div class="desk-section-heading">
        <div>
          <p class="desk-kicker">Evidence method</p>
          <h2 id="evidence-title">No mystery confidence score.</h2>
        </div>
        <p>
          I label every source. You can see what I know, how I know it, and
          where the guesswork starts.
        </p>
      </div>
      <div class="desk-grid">
        <article class="desk-card">
          <p class="desk-code">01 / direct</p>
          <h3>Personally tested</h3>
          <p>Stuff I've built, repaired, or used myself.</p>
        </article>
        <article class="desk-card">
          <p class="desk-code">02 / sourced</p>
          <h3>Reliable measurement</h3>
          <p>Manufacturer documents and credible independent testing.</p>
        </article>
        <article class="desk-card">
          <p class="desk-code">03 / limited</p>
          <h3>Listing or insufficient</h3>
          <p>Seller claims stay labeled, and missing evidence stays visible.</p>
        </article>
      </div>
    </section>

    <section class="desk-section" aria-labelledby="process-title">
      <div class="desk-section-heading">
        <div>
          <p class="desk-kicker">Three steps</p>
          <h2 id="process-title">Small desk. Human process.</h2>
        </div>
        <a class="desk-link" href="/how-it-works">See how it works →</a>
      </div>
      <div class="desk-grid desk-process">
        <article class="desk-card">
          <h3>Send the decision</h3>
          <p>
            Share the listing, shortlist, or buying problem and intended use.
          </p>
        </article>
        <article class="desk-card">
          <h3>Confirm the job</h3>
          <p>
            I'll reply with what I can check, how long it'll take, and the
            price. I wont start until you agree.
          </p>
        </article>
        <article class="desk-card">
          <h3>Receive the report</h3>
          <p>
            Get the verdict, evidence, risks, questions, and confidence by
            email.
          </p>
        </article>
      </div>
    </section>

    <section class="desk-section" aria-labelledby="operator-title">
      <div class="desk-two-column">
        <div>
          <p class="desk-kicker">The operator</p>
          <h2 id="operator-title">Advice from the workbench.</h2>
        </div>
        <div class="desk-card">
          <p>
            I’m Aim. I tear down electronics, repair broken gear, build PCs and
            home servers, tune 3D printers, and note down what worked and what
            didnt. The Buying Desk is the same skeptical work, just before you
            spend the money.
          </p>
          <a class="desk-link" href="/about">About Aim and Teardown Cafe →</a>
        </div>
      </div>
    </section>

    <section class="desk-section" aria-labelledby="notes-title">
      <div class="desk-section-heading">
        <div>
          <p class="desk-kicker">Field Notes</p>
          <h2 id="notes-title">Recent work from the bench.</h2>
        </div>
        <a class="desk-link" href="/field-notes">Browse all Field Notes →</a>
      </div>
      <div class="desk-grid">
        {
          latestNotes.map((note) => (
            <article class="desk-card desk-note-card">
              {note.data.heroImage && (
                <OptimizedImage
                  src={note.data.heroImage}
                  alt=""
                  loading="lazy"
                  aspect="video"
                  sizes="(max-width: 900px) 90vw, 360px"
                />
              )}
              <div>
                <p class="desk-code">{note.data.device}</p>
                <h3>{note.data.title}</h3>
                <p>{note.data.description}</p>
                <time datetime={note.data.pubDate.toISOString()}>
                  {note.data.pubDate.toLocaleDateString('en-US', {
                    year: 'numeric',
                    month: 'long',
                    day: 'numeric',
                  })}
                </time>
                <br />
                <a class="desk-link" href={`/teardowns/${note.id}`}>
                  Read note →
                </a>
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <section class="desk-section" aria-labelledby="faq-title">
      <div class="desk-section-heading">
        <div>
          <p class="desk-kicker">FAQ</p>
          <h2 id="faq-title">Before you send anything.</h2>
        </div>
      </div>
      <div class="desk-faq">
        <details>
          <summary>Is this an automated or AI-generated report?</summary>
          <p>
            No. I review the request and write the report myself. Research tools
            can help me find sources. The judgment is mine.
          </p>
        </details>
        <details>
          <summary>Do you earn affiliate commissions?</summary>
          <p>
            No. Affiliate links and seller payments dont affect the verdict. If
            that ever changes, I'll say it plainly.
          </p>
        </details>
        <details>
          <summary>Can you inspect a device in person?</summary>
          <p>
            Not right now. Inspect It isnt available during this pilot. I can
            only check what's visible in the listing, screenshots, and sources.
          </p>
        </details>
        <details>
          <summary>What happens after I submit the request?</summary>
          <p>
            The site opens an email draft. Nothing is sent until you press Send
            in your email app. I'll reply with scope, timing, and price.
          </p>
        </details>
      </div>
    </section>

    <section class="desk-section desk-final" aria-labelledby="final-title">
      <p class="desk-kicker">Request / copy 01</p>
      <h2 id="final-title">Put the decision on the desk.</h2>
      <p>
        No account. No upload portal. Fill this out, check the draft, and send
        it from your own email app.
      </p>
      <div class="desk-actions">
        <a class="desk-button" href="/request">Start a request</a>
      </div>
    </section>
  </div>
</BaseLayout>
