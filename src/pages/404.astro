---
import BaseLayout from '../layouts/BaseLayout.astro'
import Logo from '../components/Logo.astro'
---

<BaseLayout title="Page Not Found" description="The page you're looking for doesn't exist">
  <div class="not-found">
    <div class="glitch-container">
      <Logo class="broken-logo" />
      <div class="error-code">404</div>
    </div>

    <h1>Page Not Found</h1>
    <p>Looks like this page got disassembled and we can't find the pieces.</p>

    <div class="actions">
      <a href="/" class="primary-button">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="btn-icon">
          <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" />
          <polyline points="9 22 9 12 15 12 15 22" />
        </svg>
        Back to Home
      </a>
      <a href="/about" class="secondary-button">
        About This Site
      </a>
    </div>

    <div class="suggestions">
      <p>Maybe you were looking for:</p>
      <ul>
        <li><a href="/device/laptop">Laptop Teardowns</a></li>
        <li><a href="/device/3d-printer">3D Printer Builds</a></li>
        <li><a href="/device/raspberry-pi">Raspberry Pi Projects</a></li>
      </ul>
    </div>
  </div>
</BaseLayout>

<style>
  .not-found {
    max-width: 600px;
    margin: 0 auto;
    padding: 4rem 1.5rem;
    text-align: center;
  }

  .glitch-container {
    position: relative;
    margin-bottom: 2rem;
  }

  .broken-logo {
    width: 80px;
    height: 80px;
    color: var(--md-sys-color-on-surface-variant);
    opacity: 0.5;
  }

  .error-code {
    font-size: 6rem;
    font-weight: 700;
    color: var(--md-sys-color-primary);
    line-height: 1;
    margin-top: 1rem;
    opacity: 0.8;
  }

  h1 {
    font-size: 2rem;
    color: var(--md-sys-color-on-surface);
    margin-bottom: 0.75rem;
  }

  .not-found > p {
    color: var(--md-sys-color-on-surface-variant);
    font-size: 1.1rem;
    margin-bottom: 2rem;
  }

  .actions {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
    margin-bottom: 3rem;
  }

  .primary-button,
  .secondary-button {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1.5rem;
    border-radius: 9999px;
    text-decoration: none;
    font-weight: 500;
    transition: all 0.2s;
  }

  .primary-button {
    background: var(--md-sys-color-primary);
    color: var(--md-sys-color-on-primary);
  }

  .primary-button:hover {
    opacity: 0.9;
    transform: translateY(-2px);
  }

  .secondary-button {
    background: var(--md-sys-color-surface-container-high);
    color: var(--md-sys-color-on-surface);
  }

  .secondary-button:hover {
    background: var(--md-sys-color-surface-container-highest);
  }

  .btn-icon {
    width: 1.25rem;
    height: 1.25rem;
  }

  .suggestions {
    padding: 1.5rem;
    background: var(--md-sys-color-surface-container);
    border-radius: 12px;
  }

  .suggestions p {
    color: var(--md-sys-color-on-surface-variant);
    font-size: 0.9rem;
    margin-bottom: 1rem;
  }

  .suggestions ul {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    justify-content: center;
  }

  .suggestions a {
    padding: 0.5rem 1rem;
    background: var(--md-sys-color-surface-container-high);
    color: var(--md-sys-color-primary);
    border-radius: 8px;
    text-decoration: none;
    font-size: 0.9rem;
    transition: background 0.2s;
  }

  .suggestions a:hover {
    background: var(--md-sys-color-surface-container-highest);
  }
</style>
