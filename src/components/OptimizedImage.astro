---
/**
 * OptimizedImage — Responsive, privacy-first image component
 *
 * Reads the image manifest generated by process-images.js and outputs
 * a <picture> with WebP srcset variants. Falls back gracefully to
 * the original src if the image isn't in the manifest.
 *
 * Usage:
 *   <OptimizedImage src="/images/slug/photo.jpg" alt="Description" />
 */

import fs from 'fs'
import path from 'path'

interface Props {
  src: string
  alt: string
  class?: string
  loading?: 'lazy' | 'eager'
  sizes?: string
  aspect?: 'auto' | 'square' | 'video' | 'portrait'
}

const {
  src,
  alt,
  class: className = '',
  loading = 'lazy',
  sizes = '(max-width: 600px) 90vw, (max-width: 1024px) 50vw, 800px',
  aspect = 'auto',
} = Astro.props

// Load manifest at build time
const MANIFEST_PATH = path.resolve(process.cwd(), 'public/data/image-manifest.json')
interface ManifestVariant {
  width: number
  path: string
}

interface ManifestEntry {
  original: string
  width: number
  height: number
  variants: ManifestVariant[]
}

let manifest: Record<string, ManifestEntry> = {}
try {
  if (fs.existsSync(MANIFEST_PATH)) {
    manifest = JSON.parse(fs.readFileSync(MANIFEST_PATH, 'utf-8'))
  }
} catch {
  // Manifest missing or unreadable — fall back to plain img
}

const entry = manifest[src]

// Compute display dimensions to prevent CLS
let imgWidth: number | undefined
let imgHeight: number | undefined
let srcSet = ''
let srcUrl = src

if (entry) {
  imgWidth = entry.width
  imgHeight = entry.height
  srcUrl = entry.original

  // Build srcset from variants, sorted by width
  const variants = [...entry.variants].sort((a: ManifestVariant, b: ManifestVariant) => a.width - b.width)
  srcSet = variants.map((v: ManifestVariant) => `${v.path} ${v.width}w`).join(', ')
}

// Aspect ratio wrapper classes
const aspectClass =
  aspect === 'square'
    ? 'aspect-square'
    : aspect === 'video'
      ? 'aspect-video'
      : aspect === 'portrait'
        ? 'aspect-portrait'
        : ''
---

{
  entry ? (
    <picture class={`optimized-picture ${aspectClass} ${className}`}>
      <source type="image/webp" srcset={srcSet} sizes={sizes} />
      <img
        src={srcUrl}
        alt={alt}
        loading={loading}
        width={imgWidth}
        height={imgHeight}
        decoding="async"
        class="optimized-img"
      />
    </picture>
  ) : (
    <img
      src={src}
      alt={alt}
      loading={loading}
      class={`optimized-img ${className}`}
      decoding="async"
    />
  )
}

<style>
  .optimized-picture {
    display: block;
    width: 100%;
  }

  .optimized-img {
    width: 100%;
    height: auto;
    display: block;
    border-radius: var(--md-sys-shape-corner-medium);
    background-color: var(--md-sys-color-surface-container-low);
    transition: opacity 0.3s ease;
  }

  .aspect-square .optimized-img {
    aspect-ratio: 1 / 1;
    object-fit: cover;
  }

  .aspect-video .optimized-img {
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }

  .aspect-portrait .optimized-img {
    aspect-ratio: 3 / 4;
    object-fit: cover;
  }
</style>
