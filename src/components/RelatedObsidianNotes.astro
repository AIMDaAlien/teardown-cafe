---
import fs from 'fs'
import path from 'path'

interface Props {
  tags: string[]
  slug: string
}

interface Note {
  path: string
  title: string
  url: string
}

interface Relationship {
  obsidianNotes: Note[]
}

const { tags, slug } = Astro.props

// Load relationships from disk at build time
let relationships: Record<string, Relationship> = {}
try {
  const filePath = path.join(process.cwd(), 'public/data/obsidian-relationships.json')
  if (fs.existsSync(filePath)) {
    const raw = fs.readFileSync(filePath, 'utf-8')
    relationships = JSON.parse(raw)
  }
} catch {
  relationships = {}
}

// Find all related notes for these tags
const relatedNotes = new Map<string, Note>()

tags.forEach((tag) => {
  if (relationships[tag]?.obsidianNotes) {
    relationships[tag].obsidianNotes.forEach((note) => {
      relatedNotes.set(note.path, note)
    })
  }
})

// Check for manual additions
const manualTag = `manual-${slug}`
if (relationships[manualTag]?.obsidianNotes) {
  relationships[manualTag].obsidianNotes.forEach((note) => {
    relatedNotes.set(note.path, note)
  })
}

const notes = Array.from(relatedNotes.values())
---

{
  notes.length > 0 && (
    <section class="related-obsidian">
      <h3>
        <svg class="notes-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20" />
          <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z" />
          <line x1="8" y1="7" x2="16" y2="7" />
          <line x1="8" y1="11" x2="14" y2="11" />
        </svg>
        Related in Knowledge Garden
      </h3>
      <ul>
        {notes.map((note) => (
          <li>
            <a href={note.url} target="_blank" rel="noopener">
              {note.title}
              <svg
                class="external-link"
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
              >
                <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6M15 3h6v6M10 14L21 3" />
              </svg>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )
}

<style>
  .related-obsidian {
    margin: 2rem 0;
    padding: 1.5rem;
    background: var(--md-sys-color-surface-container-low);
    border-radius: 12px;
  }

  .related-obsidian h3 {
    margin-bottom: 1rem;
    color: var(--md-sys-color-on-surface);
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .related-obsidian h3 .notes-icon {
    width: 1.25rem;
    height: 1.25rem;
    color: var(--md-sys-color-primary);
  }

  .related-obsidian ul {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .related-obsidian a {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--md-sys-color-primary);
    text-decoration: none;
    transition: color 0.2s;
  }

  .related-obsidian a:hover {
    color: var(--md-sys-color-primary-container);
  }

  .external-link {
    width: 14px;
    height: 14px;
    opacity: 0.6;
  }
</style>
