---
// Teardown Cafe Logo - Teahouse Gaiwan with Chip
// Lavender accent color matching brand
interface Props {
  class?: string
  showWordmark?: boolean
}

const { class: className = '', showWordmark = false } = Astro.props
---

<div class={`logo ${showWordmark ? 'with-wordmark' : ''} ${className}`}>
  <svg
    class="logo-icon"
    viewBox="0 0 24 24"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
  >
    <!-- Gaiwan bowl (tea bowl) -->
    <path
      d="M6 11C6 11 6 17 12 17C18 17 18 11 18 11"
      stroke="currentColor"
      stroke-width="1.4"
      stroke-linecap="round"></path>
    <!-- Gaiwan saucer/base -->
    <ellipse
      cx="12"
      cy="18"
      rx="4"
      ry="1.2"
      stroke="currentColor"
      stroke-width="1.2"></ellipse>
    <!-- Gaiwan lid (tilted open) -->
    <ellipse
      cx="13"
      cy="8"
      rx="4"
      ry="1.5"
      stroke="currentColor"
      stroke-width="1.2"
      transform="rotate(-15 13 8)"></ellipse>
    <!-- Lid knob -->
    <ellipse
      cx="15"
      cy="6.5"
      rx="0.8"
      ry="0.5"
      stroke="currentColor"
      stroke-width="1"></ellipse>
    <!-- Internal chip revealed -->
    <rect
      x="9.5"
      y="11.5"
      width="5"
      height="4"
      rx="0.5"
      stroke="var(--logo-accent, #d4bcff)"
      stroke-width="1"></rect>
    <!-- Chip circuit traces extending like branches -->
    <line
      x1="9.5"
      y1="12.5"
      x2="7.5"
      y2="11"
      stroke="var(--logo-accent, #d4bcff)"
      stroke-width="0.8"
      stroke-linecap="round"></line>
    <line
      x1="9.5"
      y1="14.5"
      x2="7"
      y2="15"
      stroke="var(--logo-accent, #d4bcff)"
      stroke-width="0.8"
      stroke-linecap="round"></line>
    <line
      x1="14.5"
      y1="12.5"
      x2="16.5"
      y2="11"
      stroke="var(--logo-accent, #d4bcff)"
      stroke-width="0.8"
      stroke-linecap="round"></line>
    <line
      x1="14.5"
      y1="14.5"
      x2="17"
      y2="15"
      stroke="var(--logo-accent, #d4bcff)"
      stroke-width="0.8"
      stroke-linecap="round"></line>
    <!-- Circuit trace nodes (leaf-like endpoints) -->
    <circle cx="7.5" cy="11" r="0.5" fill="var(--logo-accent, #d4bcff)"
    ></circle>
    <circle cx="7" cy="15" r="0.5" fill="var(--logo-accent, #d4bcff)"></circle>
    <circle cx="16.5" cy="11" r="0.5" fill="var(--logo-accent, #d4bcff)"
    ></circle>
    <circle cx="17" cy="15" r="0.5" fill="var(--logo-accent, #d4bcff)"></circle>
  </svg>
  {showWordmark && <span class="wordmark">teardown cafe</span>}
</div>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    --logo-accent: var(--md-sys-color-primary, #d4bcff);
  }

  .logo-icon {
    width: 28px;
    height: 28px;
    color: currentColor;
  }

  .with-wordmark {
    gap: 0.6rem;
  }

  .with-wordmark .logo-icon {
    width: 32px;
    height: 32px;
  }

  .wordmark {
    font-family: 'Ubuntu', sans-serif;
    font-size: 1.5rem;
    font-weight: 500;
    color: currentColor;
  }

  /* Hover effect */
  .logo:hover .logo-icon {
    transform: scale(1.05);
    transition: transform 0.2s ease;
  }
</style>
