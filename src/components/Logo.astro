---
// Teardown Cafe Logo - Teahouse Gaiwan with Chip
// Using PNG image for the logo
interface Props {
  class?: string
  showWordmark?: boolean
}

const { class: className = '', showWordmark = false } = Astro.props
---

<div class={`logo ${showWordmark ? 'with-wordmark' : ''} ${className}`}>
  <img
    class="logo-icon"
    src="/logo.png"
    alt="Teardown Cafe"
    width="28"
    height="28"
  />
  {showWordmark && <span class="wordmark">teardown cafe</span>}
</div>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
  }

  .logo-icon {
    width: 28px;
    height: 28px;
    object-fit: contain;
  }

  .with-wordmark {
    gap: 0.6rem;
  }

  .with-wordmark .logo-icon {
    width: 32px;
    height: 32px;
  }

  .wordmark {
    font-family: 'Ubuntu', sans-serif;
    font-size: 1.5rem;
    font-weight: 500;
    color: currentColor;
  }

  /* Hover effect */
  .logo:hover .logo-icon {
    transform: scale(1.05);
    transition: transform 0.2s ease;
  }
</style>
