---
import OptimizedImage from './OptimizedImage.astro'
import { getCollection } from 'astro:content'

const prints = await getCollection('prints')
const featured = prints
  .filter((p) => p.data.featured)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 4)
---

{
  featured.length > 0 && (
    <section class="featured-prints">
      <div class="featured-header">
        <h2 class="section-title">🖨️ Featured Prints</h2>
        <a href="/prints/" class="view-all">
          View all prints
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M5 12h14M12 5l7 7-7 7" />
          </svg>
        </a>
      </div>

      <div class="featured-grid">
        {featured.map((print) => (
          <a href={`/prints/${print.id}/`} class="featured-card">
            <div class="featured-image">
              <OptimizedImage
                src={print.data.image}
                alt={print.data.title}
                aspect="square"
              />
            </div>
            <div class="featured-info">
              <h3>{print.data.title}</h3>
              <div class="featured-meta">
                {print.data.printer && (
                  <span class="meta-pill">{print.data.printer}</span>
                )}
                <span class="meta-pill category">{print.data.category}</span>
              </div>
            </div>
          </a>
        ))}
      </div>
    </section>
  )
}

<style>
  .featured-prints {
    margin: 3rem 0;
  }

  .featured-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1.5rem;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .section-title {
    font-size: 1.75rem;
    margin: 0;
  }

  .view-all {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--md-sys-color-primary);
    text-decoration: none;
    font-size: 0.9375rem;
    font-weight: 500;
  }

  .view-all:hover {
    text-decoration: underline;
  }

  .view-all svg {
    width: 1rem;
    height: 1rem;
  }

  .featured-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 1.25rem;
  }

  .featured-card {
    background: var(--md-sys-color-surface-container);
    border-radius: 12px;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    transition:
      transform 0.2s,
      box-shadow 0.2s;
  }

  .featured-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.15);
  }

  .featured-image {
    width: 100%;
    aspect-ratio: 1;
    overflow: hidden;
  }

  .featured-image :global(.optimized-img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 0;
  }

  .featured-info {
    padding: 0.875rem;
  }

  .featured-info h3 {
    margin: 0 0 0.5rem 0;
    font-size: 0.9375rem;
    line-height: 1.3;
  }

  .featured-meta {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .meta-pill {
    padding: 0.2rem 0.5rem;
    background: var(--md-sys-color-primary-container);
    color: var(--md-sys-color-on-primary-container);
    border-radius: 4px;
    font-size: 0.7rem;
  }

  .meta-pill.category {
    background: var(--md-sys-color-tertiary-container);
    color: var(--md-sys-color-on-tertiary-container);
  }

  @media (max-width: 640px) {
    .featured-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 1rem;
    }
  }
</style>
