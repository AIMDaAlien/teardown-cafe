---
// Layered Wave Diffusions - Periwinkle palette with no gradients
// Multiple layered waves with opacity for depth effect
// ENHANCED with MORE NOTICEABLE subtle wave motion
// Increased saturation from base palette
---

<div class="wave-diffusions" aria-hidden="true">
  <!-- Layer 1: Primary periwinkle wave -->
  <svg
    class="wave-layer wave-layer-1"
    viewBox="0 0 1440 320"
    preserveAspectRatio="none"
    xmlns="http://www.w3.org/2000/svg"
  >
    <path
      fill="#D4BCFF"
      fill-opacity="0.12"
      d="M0,96L48,112C96,128,192,160,288,160C384,160,480,128,576,112C672,96,768,96,864,112C960,128,1056,160,1152,165.3C1248,171,1344,149,1392,138.7L1440,128L1440,320L1392,320C1344,320,1248,320,1152,320C1056,320,960,320,864,320C768,320,672,320,576,320C480,320,384,320,288,320C192,320,96,320,48,320L0,320Z"
    ></path>
  </svg>

  <!-- Layer 2: Deeper periwinkle base -->
  <svg
    class="wave-layer wave-layer-2"
    viewBox="0 0 1440 320"
    preserveAspectRatio="none"
    xmlns="http://www.w3.org/2000/svg"
  >
    <path
      fill="#B8B3FF"
      fill-opacity="0.07"
      d="M0,160L48,170.7C96,181,192,203,288,197.3C384,192,480,160,576,138.7C672,117,768,107,864,117.3C960,128,1056,160,1152,165.3C1248,171,1344,149,1392,138.7L1440,128L1440,320L1392,320C1344,320,1248,320,1152,320C1056,320,960,320,864,320C768,320,672,320,576,320C480,320,384,320,288,320C192,320,96,320,48,320L0,320Z"
    ></path>
  </svg>
</div>

<style>
  .wave-diffusions {
    position: fixed;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 320px;
    pointer-events: none;
    z-index: 0;
    overflow: hidden;
  }

  .wave-layer {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 100%;
    will-change: transform;
  }

  /* Two-layer subtle drift — slower, calmer */
  .wave-layer-1 {
    transform: translateY(0);
    animation: waveFloat1 18s ease-in-out infinite;
  }

  .wave-layer-2 {
    transform: translateY(12px);
    animation: waveFloat2 22s ease-in-out infinite 1.5s;
  }

  @keyframes waveFloat1 {
    0%, 100% {
      transform: translateY(0) translateX(0) scaleY(1);
      opacity: 0.12;
    }
    50% {
      transform: translateY(-6px) translateX(8px) scaleY(1.02);
      opacity: 0.14;
    }
  }

  @keyframes waveFloat2 {
    0%, 100% {
      transform: translateY(12px) translateX(0) scaleY(1);
      opacity: 0.07;
    }
    50% {
      transform: translateY(6px) translateX(-10px) scaleY(1.02);
      opacity: 0.09;
    }
  }

  /* Respect reduced motion preferences */
  @media (prefers-reduced-motion: reduce) {
    .wave-layer {
      animation: none !important;
    }

    .wave-layer-1 {
      transform: translateY(0);
      opacity: 0.12;
    }
    .wave-layer-2 {
      transform: translateY(12px);
      opacity: 0.07;
    }
  }

  /* Responsive height adjustments */
  @media (max-width: 1024px) {
    .wave-diffusions {
      height: 240px;
    }
  }

  @media (max-width: 768px) {
    .wave-diffusions {
      height: 180px;
    }

    /* Reduce animation intensity on mobile */
    @keyframes waveFloat1 {
      0%, 100% {
        transform: translateY(0) translateX(0) scaleY(1);
      }
      50% {
        transform: translateY(-3px) translateX(0) scaleY(1.01);
      }
    }

    @keyframes waveFloat2 {
      0%, 100% {
        transform: translateY(12px) translateX(0) scaleY(1);
      }
      50% {
        transform: translateY(9px) translateX(0) scaleY(1.01);
      }
    }
  }
</style>
