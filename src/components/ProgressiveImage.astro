---
interface Props {
  src: string
  alt: string
  width?: number
  height?: number
  class?: string
  loading?: 'lazy' | 'eager'
}

const {
  src,
  alt,
  width,
  height,
  class: className = '',
  loading = 'lazy',
} = Astro.props

// Build inline style string properly (single attribute)
const styleProps = [
  width ? `width: ${width}px` : '',
  height ? `height: ${height}px` : '',
].filter(Boolean).join('; ')
---

<div class={`progressive-image ${className}`}>
  <div class="image-container">
    <img
      src={src}
      alt={alt}
      class="main-image"
      loading={loading}
      width={width}
      height={height}
      style={styleProps || undefined}
    />
  </div>
</div>

<style>
  .progressive-image {
    position: relative;
    overflow: hidden;
    border-radius: var(--md-sys-shape-corner-medium);
  }

  /* Use padding trick for aspect ratio, container fills it */
  .progressive-image::before {
    content: '';
    display: block;
    padding-top: 56.25%; /* 16:9 aspect ratio */
  }

  .image-container {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
  }

  .main-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    background-color: var(--md-sys-color-surface-container-low);
  }

  .progressive-image[data-aspect='square']::before {
    padding-top: 100%;
  }

  .progressive-image[data-aspect='portrait']::before {
    padding-top: 133.33%; /* 3:4 aspect ratio */
  }

  .progressive-image[data-aspect='landscape']::before {
    padding-top: 75%; /* 4:3 aspect ratio */
  }
</style>
