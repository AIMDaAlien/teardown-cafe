---
import '../styles/global.css'
import '../styles/buying-desk.css'
import ThemeToggle from '../components/ThemeToggle.astro'
import Logo from '../components/Logo.astro'
import Search from '../components/Search.astro'
import Lightbox from '../components/Lightbox.astro'

interface Props {
  title: string
  description?: string
  image?: string
  type?: 'website' | 'article'
  noindex?: boolean
}

const {
  title,
  description = 'A cafe where devices are torn down, built, and analyzed',
  image = '/og-default.png',
  type = 'website',
  noindex = false,
} = Astro.props

const siteURL = Astro.site || new URL('https://teardown.cafe')
const canonicalURL = new URL(Astro.url.pathname, siteURL)
const ogImageURL = new URL(image, siteURL)
const pathname = Astro.url.pathname
const pageTitle = `${title} | Teardown Cafe`
const robots = noindex
  ? 'noindex, nofollow'
  : 'index, follow, max-image-preview:large'
const homeSchema =
  pathname === '/'
    ? {
        '@context': 'https://schema.org',
        '@graph': [
          {
            '@type': 'WebSite',
            '@id': new URL('/#website', siteURL).href,
            url: new URL('/', siteURL).href,
            name: 'The Buying Desk by Teardown Cafe',
            alternateName: 'Teardown Cafe',
            description,
          },
          {
            '@type': 'Organization',
            '@id': new URL('/#organization', siteURL).href,
            name: 'The Buying Desk by Teardown Cafe',
            alternateName: 'Teardown Cafe',
            url: new URL('/', siteURL).href,
            logo: new URL('/logo.png', siteURL).href,
            description:
              'Independent technology buying advice and hands-on Field Notes from Aim.',
          },
          {
            '@type': 'Service',
            '@id': new URL('/#buying-desk', siteURL).href,
            name: 'The Buying Desk',
            serviceType: 'Independent technology buying advice',
            url: new URL('/services', siteURL).href,
            provider: {
              '@id': new URL('/#organization', siteURL).href,
            },
            description,
            hasOfferCatalog: {
              '@type': 'OfferCatalog',
              name: 'Buying advice services',
              itemListElement: [
                'Check This',
                'Compare These',
                'Choose for Me',
              ].map((name) => ({
                '@type': 'Offer',
                itemOffered: {
                  '@type': 'Service',
                  name,
                },
              })),
            },
          },
        ],
      }
    : undefined
const navItems = [
  { href: '/services', label: 'Services' },
  { href: '/sample-report', label: 'Sample Report' },
  { href: '/field-notes', label: 'Field Notes' },
  { href: '/about', label: 'About' },
]
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="author" content="Aim" />
    <meta name="robots" content={robots} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="canonical" href={canonicalURL} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Teardown Cafe RSS"
      href="/rss.xml"
    />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={type} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:alt" content={pageTitle} />
    <meta property="og:site_name" content="Teardown Cafe" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />
    <meta name="twitter:image:alt" content={pageTitle} />
    {
      homeSchema && (
        <script
          type="application/ld+json"
          set:html={JSON.stringify(homeSchema)}
        />
      )
    }
    <title>{pageTitle}</title>

    <!-- Theme initialization script -->
    <script>
      // Prevent flash of wrong theme - default to dark
      ;(function () {
        const savedTheme = localStorage.getItem('theme')
        const theme = savedTheme || 'dark'
        document.documentElement.setAttribute('data-theme', theme)
      })()
    </script>
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to content</a>
    <header class="site-header">
      <div class="header-content">
        <a
          href="/"
          class="site-title"
          aria-label="The Buying Desk by Teardown Cafe, home"
        >
          <Logo />
          <span class="site-wordmark">
            <strong>teardown cafe</strong>
            <small>The Buying Desk</small>
          </span>
        </a>
        <div class="header-actions">
          <nav class="site-nav desktop-nav" aria-label="Primary navigation">
            {
              navItems.map((item) => (
                <a
                  href={item.href}
                  class="nav-link"
                  aria-current={pathname === item.href ? 'page' : undefined}
                >
                  {item.label}
                </a>
              ))
            }
            <a
              href="/request"
              class="nav-link nav-request"
              aria-current={pathname === '/request' ? 'page' : undefined}
              >Request</a
            >
          </nav>
          <details class="nav-disclosure">
            <summary>Menu</summary>
            <nav class="site-nav" aria-label="Mobile navigation">
              {
                navItems.map((item) => (
                  <a
                    href={item.href}
                    class="nav-link"
                    aria-current={pathname === item.href ? 'page' : undefined}
                  >
                    {item.label}
                  </a>
                ))
              }
              <a
                href="/request"
                class="nav-link nav-request"
                aria-current={pathname === '/request' ? 'page' : undefined}
                >Request</a
              >
            </nav>
          </details>
          <Search />
          <ThemeToggle />
        </div>
      </div>
    </header>

    <main class="main-content" id="main-content">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="footer-content">
        <div>
          <strong>The Buying Desk</strong>
          <p>Straight buying advice from my workbench.</p>
        </div>
        <nav aria-label="Footer navigation">
          <a href="/services">Services</a>
          <a href="/sample-report">Sample Report</a>
          <a href="/how-it-works">How it works</a>
          <a href="/field-notes">Field Notes</a>
          <a href="/about">About</a>
          <a href="/request">Request</a>
          <a href="/privacy">Privacy</a>
          <a href="/terms">Terms</a>
        </nav>
        <p>&copy; {new Date().getFullYear()} Teardown Cafe.</p>
      </div>
    </footer>

    <Lightbox />
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    top: -100%;
    left: 50%;
    transform: translateX(-50%);
    z-index: 1000;
    padding: 0.75rem 1.5rem;
    background: var(--md-sys-color-primary);
    color: var(--md-sys-color-on-primary);
    font-weight: 500;
    border-radius: 0 0 var(--md-sys-shape-corner-medium)
      var(--md-sys-shape-corner-medium);
    text-decoration: none;
    transition: top 0.2s ease;
  }

  .skip-link:focus {
    top: 0;
  }

  .site-header {
    background-color: var(--md-sys-color-surface-container);
    border-bottom: 1px solid var(--md-sys-color-outline-variant);
    position: sticky;
    top: 0;
    z-index: 10;
    backdrop-filter: blur(16px);
  }

  .header-content {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0.45rem 1.5rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .site-title {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--md-sys-color-primary);
    text-decoration: none;
    transition: color var(--md-sys-motion-duration-short)
      var(--md-sys-motion-easing-standard);
  }

  .site-wordmark {
    display: grid;
    gap: 0.15rem;
  }

  .site-wordmark strong {
    color: inherit;
    font: 500 1.5rem/1 var(--md-sys-typescale-brand-font);
  }

  .site-wordmark small {
    color: var(--md-sys-color-on-surface-variant);
    font: 600 0.62rem/1 var(--md-sys-typescale-code-font);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .site-title:hover {
    color: var(--md-sys-color-on-primary-container);
  }

  .site-nav {
    display: flex;
    gap: 0.1rem;
  }

  .nav-disclosure summary {
    display: none;
  }

  .nav-disclosure {
    display: none;
  }

  .nav-link {
    color: var(--md-sys-color-on-surface);
    text-decoration: none;
    padding: 0.5rem 0.65rem;
    border-radius: var(--md-sys-shape-corner-full);
    transition: all var(--md-sys-motion-duration-short)
      var(--md-sys-motion-easing-standard);
  }

  .nav-link[aria-current='page'] {
    color: var(--md-sys-color-primary);
    background: var(--md-sys-color-surface-container-highest);
  }

  .nav-request {
    color: var(--md-sys-color-on-primary);
    background: var(--md-sys-color-primary);
  }

  .nav-request:hover {
    color: var(--md-sys-color-on-primary);
    background: var(--md-sys-color-primary-container);
  }

  .nav-link:hover {
    color: var(--md-sys-color-primary);
    background-color: var(--md-sys-color-surface-container-highest);
  }

  .main-content {
    max-width: 1200px;
    margin: 0 auto;
    padding: 2rem 1.5rem;
    min-height: calc(100vh - 200px);
  }

  .site-footer {
    background-color: var(--md-sys-color-surface-container);
    border-top: 1px solid var(--md-sys-color-outline-variant);
    margin-top: 4rem;
  }

  .footer-content {
    max-width: 1200px;
    margin: 0 auto;
    padding: 2rem 1.5rem;
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 2rem;
  }

  .footer-content p {
    margin: 0;
    color: var(--md-sys-color-on-surface-variant);
  }

  .footer-content nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
  }

  .footer-content a {
    color: var(--md-sys-color-on-surface-variant);
  }

  @media (max-width: 1050px) {
    .header-content {
      position: relative;
      gap: 0.5rem;
    }

    .header-actions {
      margin-left: auto;
    }

    .nav-disclosure summary {
      min-height: 44px;
      display: grid;
      place-items: center;
      padding: 0 0.8rem;
      border: 1px solid var(--md-sys-color-outline-variant);
      border-radius: var(--md-sys-shape-corner-full);
      background: var(--md-sys-color-surface-container-high);
      color: var(--md-sys-color-on-surface);
      font-weight: 600;
      cursor: pointer;
      list-style: none;
    }

    .nav-disclosure {
      display: block;
    }

    .nav-disclosure summary::-webkit-details-marker {
      display: none;
    }

    .nav-disclosure:not([open]) > .site-nav {
      display: none;
    }

    .site-nav {
      position: absolute;
      inset: calc(100% + 0.35rem) 1rem auto;
      display: grid;
      gap: 0.25rem;
      padding: 0.75rem;
      border: 1px solid var(--md-sys-color-outline-variant);
      border-radius: var(--md-sys-shape-corner-medium);
      background: var(--md-sys-color-surface-container);
      box-shadow: var(--md-sys-elevation-level3);
    }

    .site-nav.desktop-nav {
      display: none;
    }

    .nav-link {
      min-height: 44px;
      display: flex;
      align-items: center;
    }
  }

  @media (max-width: 768px) {
    .site-wordmark {
      display: none;
    }

    .footer-content {
      flex-direction: column;
      gap: 1rem;
      text-align: center;
    }
  }

  @media (max-width: 430px) {
    .header-content {
      padding-inline: 0.75rem;
    }

    .header-actions {
      gap: 0.35rem;
    }
  }
</style>
