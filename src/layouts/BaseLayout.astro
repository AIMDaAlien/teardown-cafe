---
import '../styles/global.css'
import ThemeToggle from '../components/ThemeToggle.astro'
import Analytics from '../components/Analytics.astro'
import Logo from '../components/Logo.astro'
import Search from '../components/Search.astro'

interface Props {
  title: string
  description?: string
  image?: string
  type?: 'website' | 'article'
}

const {
  title,
  description = 'A cafe where devices are torn down, built, and analyzed',
  image = '/og-default.png',
  type = 'website',
} = Astro.props

const canonicalURL = new URL(
  Astro.url.pathname,
  Astro.site || 'https://teardown.cafe'
)
const ogImageURL = new URL(image, Astro.site || 'https://teardown.cafe')
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="canonical" href={canonicalURL} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Teardown Cafe RSS"
      href="/rss.xml"
    />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={`${title} | Teardown Cafe`} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:site_name" content="Teardown Cafe" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={`${title} | Teardown Cafe`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Ubuntu:wght@400;500;700&family=JetBrains+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <title>{title} | Teardown Cafe</title>

    <!-- Theme initialization script -->
    <script>
      // Prevent flash of wrong theme - default to dark
      ;(function () {
        const savedTheme = localStorage.getItem('theme')
        const theme = savedTheme || 'dark'
        document.documentElement.setAttribute('data-theme', theme)
      })()
    </script>
  </head>
  <body>
    <header class="site-header">
      <div class="header-content">
        <a href="/" class="site-title">
          <Logo showWordmark={true} />
        </a>
        <div class="header-actions">
          <nav class="site-nav">
            <a href="/" class="nav-link">Home</a>
            <a href="/discoveries" class="nav-link">Discoveries</a>
            <a href="/about" class="nav-link">About</a>
          </nav>
          <Search />
          <ThemeToggle />
        </div>
      </div>
    </header>

    <main class="main-content">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="footer-content">
        <p>
          &copy; {new Date().getFullYear()} Teardown Cafe. Built with Astro.
        </p>
        <p>Sipping coffee while tinkering.</p>
      </div>
    </footer>

    <Analytics />
  </body>
</html>

<style>
  .site-header {
    background-color: var(--md-sys-color-surface-container);
    border-bottom: 1px solid var(--md-sys-color-outline-variant);
    position: sticky;
    top: 0;
    z-index: 10;
    backdrop-filter: blur(12px);
  }

  .header-content {
    max-width: 1200px;
    margin: 0 auto;
    padding: 7px 1.5rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 2rem;
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .site-title {
    color: var(--md-sys-color-primary);
    text-decoration: none;
    transition: color var(--md-sys-motion-duration-short)
      var(--md-sys-motion-easing-standard);
  }

  .site-title:hover {
    color: var(--md-sys-color-on-primary-container);
  }

  .site-nav {
    display: flex;
    gap: 1.5rem;
  }

  .nav-link {
    color: var(--md-sys-color-on-surface);
    text-decoration: none;
    padding: 0.5rem 1rem;
    border-radius: var(--md-sys-shape-corner-full);
    transition: all var(--md-sys-motion-duration-short)
      var(--md-sys-motion-easing-standard);
  }

  .nav-link:hover {
    color: var(--md-sys-color-primary);
    background-color: var(--md-sys-color-surface-container-highest);
  }

  .main-content {
    max-width: 1200px;
    margin: 0 auto;
    padding: 2rem 1.5rem;
    min-height: calc(100vh - 200px);
  }

  .site-footer {
    background-color: var(--md-sys-color-surface-container);
    border-top: 1px solid var(--md-sys-color-outline-variant);
    margin-top: 4rem;
  }

  .footer-content {
    max-width: 1200px;
    margin: 0 auto;
    padding: 2rem 1.5rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .footer-content p {
    margin: 0;
    color: var(--md-sys-color-on-surface-variant);
  }

  @media (max-width: 768px) {
    .header-content {
      flex-direction: column;
      gap: 1rem;
      align-items: flex-start;
    }

    .header-actions {
      width: 100%;
      justify-content: space-between;
    }

    .site-nav {
      gap: 1rem;
    }

    .footer-content {
      flex-direction: column;
      gap: 1rem;
      text-align: center;
    }
  }
</style>
